{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-latency:sla-targets:1.0",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "model",
      "model_version",
      "offering_type",
      "pool_type",
      "target",
      "value",
      "ingestion_time"
    ],
    "properties": {
      "model": {
        "type": "string",
        "minLength": 1
      },
      "model_version": {
        "type": "string",
        "minLength": 1
      },
      "offering_type": {
        "type": "string",
        "minLength": 1
      },
      "pool_type": {
        "enum": ["cold", "hot"]
      },
      "target": {
        "type": "string",
        "pattern": "^SLA_P[0-9]+_(TTFT|TBT|TTLT)$"
      },
      "value": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "ingestion_time": {
        "type": "string",
        "format": "date-time"
      }
    },
    "additionalProperties": false
  }
}
