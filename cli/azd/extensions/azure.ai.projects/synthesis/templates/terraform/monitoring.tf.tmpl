variable "monitoring_mode" {
  type        = string
  description = "Monitoring ownership: none, create, reuse-connect, or already-connected. Removing managed resources has normal Terraform destroy semantics."

  validation {
    condition     = contains(["none", "create", "reuse-connect", "already-connected"], var.monitoring_mode)
    error_message = "monitoring_mode must be none, create, reuse-connect, or already-connected."
  }
  validation {
    condition     = var.monitoring_mode != "create" || {{ .CreateSupported }}
    error_message = "Create mode requires a declared owned resource group; add that graph before changing a reuse-only export to create."
  }
}

variable "application_insights_resource_id" {
  type        = string
  default     = ""
  description = "Existing Application Insights component ARM ID; credentials are resolved ephemerally."

  validation {
    condition = contains(["none", "create"], var.monitoring_mode) || can(regex(
      "(?i)^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft\\.Insights/components/[^/]+$",
      var.application_insights_resource_id,
    ))
    error_message = "Reusing monitoring requires the full Application Insights component ARM ID."
  }
}

locals {
  monitoring_enabled      = var.monitoring_mode != "none"
  monitoring_managed      = contains(["create", "reuse-connect"], var.monitoring_mode)
  monitoring_project_id   = {{ .ProjectID }}
  monitoring_account_id   = {{ .AccountID }}
  monitoring_group_id     = {{ .GroupID }}
  monitoring_project_name = element(reverse(split("/", local.monitoring_project_id)), 0)
  monitoring_name         = "azd-appinsights-${substr(replace(uuidv5("11fb06fb-712d-4ddd-98c7-e71bbd588830", lower(local.monitoring_project_name)), "-", ""), 0, 13)}"
  monitoring_token        = substr(sha1(lower("${local.monitoring_project_id}|${local.monitoring_group_id}|${var.resource_token_salt}")), 0, 13)
  monitoring_component_id = var.monitoring_mode == "create" ? "${local.monitoring_group_id}/providers/Microsoft.Insights/components/appi-${local.monitoring_token}" : var.application_insights_resource_id
  monitoring_workspace_id = "${local.monitoring_group_id}/providers/Microsoft.OperationalInsights/workspaces/log-${local.monitoring_token}"
  monitoring_tags = merge(var.tags, {
    "azd-created-by"         = "azure.ai.projects"
    "azd-environment"        = var.environment_name
    "azd-monitoring-project" = local.monitoring_project_id
  })
  monitoring_policy_fields = {
    present              = "properties != `null`"
    resource_id          = "id"
    local_auth           = "properties.DisableLocalAuth"
    workspace_local_auth = "properties.features.disableLocalAuth"
    ingestion            = "properties.publicNetworkAccessForIngestion"
    public_access        = "properties.publicNetworkAccess"
    default_action       = "properties.networkAcls.defaultAction"
  }
  monitoring_connection_fields = {
    connections = "value[].{name:name,category:properties.category,target:properties.target,auth:properties.authType,shared:properties.isSharedToAll,restricted:length(not_null(properties.sharedUserList, `[]`)),resource_id:properties.metadata.ResourceId,creator:properties.metadata.\"azd-created-by\",environment:properties.metadata.\"azd-environment\",project:properties.metadata.\"azd-project-id\"}"
  }
}

data "azapi_resource" "monitoring_project" {
  count                  = local.monitoring_enabled ? 1 : 0
  type                   = "Microsoft.CognitiveServices/accounts/projects@2025-04-01-preview"
  resource_id            = local.monitoring_project_id
  response_export_values = local.monitoring_policy_fields
}

data "azapi_resource" "monitoring_account" {
  count                  = local.monitoring_enabled ? 1 : 0
  type                   = "Microsoft.CognitiveServices/accounts@2025-04-01-preview"
  resource_id            = local.monitoring_account_id
  response_export_values = local.monitoring_policy_fields
}

data "azapi_resource_list" "monitoring_project_connections" {
  count                  = local.monitoring_enabled ? 1 : 0
  type                   = "Microsoft.CognitiveServices/accounts/projects/connections@2025-04-01-preview"
  parent_id              = local.monitoring_project_id
  response_export_values = local.monitoring_connection_fields
}

data "azapi_resource_list" "monitoring_account_connections" {
  count                  = local.monitoring_enabled ? 1 : 0
  type                   = "Microsoft.CognitiveServices/accounts/connections@2025-04-01-preview"
  parent_id              = local.monitoring_account_id
  response_export_values = local.monitoring_connection_fields
}

data "azapi_resource" "monitoring_component" {
  count            = local.monitoring_enabled ? 1 : 0
  type             = "Microsoft.Insights/components@2020-02-02"
  resource_id      = local.monitoring_component_id
  ignore_not_found = true
  response_export_values = merge(local.monitoring_policy_fields, {
    app_id       = "properties.AppId"
    workspace_id = "properties.WorkspaceResourceId"
  })

  lifecycle {
    postcondition {
      condition = self.exists ? (
        try(self.output.present, false) == true &&
        try(lower(self.output.resource_id), "") == lower(local.monitoring_component_id) &&
        can(regex("(?i)^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft\\.OperationalInsights/workspaces/[^/]+$", self.output.workspace_id)) &&
        try(length(self.output.app_id) > 0, false)
      ) : var.monitoring_mode == "create"
      error_message = "Application Insights must exist at the selected identity and reference an accessible Log Analytics workspace."
    }
  }
}

data "azapi_resource" "monitoring_workspace" {
  count                  = contains(["reuse-connect", "already-connected"], var.monitoring_mode) ? 1 : 0
  type                   = "Microsoft.OperationalInsights/workspaces@2023-09-01"
  resource_id            = data.azapi_resource.monitoring_component[0].output.workspace_id
  response_export_values = local.monitoring_policy_fields

  lifecycle {
    postcondition {
      condition = (
        try(self.output.present, false) == true &&
        try(lower(self.output.resource_id), "") == lower(data.azapi_resource.monitoring_component[0].output.workspace_id)
      )
      error_message = "The linked Log Analytics workspace could not be verified."
    }
  }
}

data "azapi_resource" "monitoring_owned_workspace" {
  count                  = var.monitoring_mode == "create" ? 1 : 0
  type                   = "Microsoft.OperationalInsights/workspaces@2023-09-01"
  resource_id            = local.monitoring_workspace_id
  ignore_not_found       = true
  response_export_values = local.monitoring_policy_fields
}

data "azapi_resource" "monitoring_connection_slot" {
  count            = local.monitoring_managed ? 1 : 0
  type             = "Microsoft.CognitiveServices/accounts/projects/connections@2025-04-01-preview"
  resource_id      = "${local.monitoring_project_id}/connections/${local.monitoring_name}"
  ignore_not_found = true
  response_export_values = {
    name        = "name"
    category    = "properties.category"
    target      = "properties.target"
    auth        = "properties.authType"
    shared      = "properties.isSharedToAll"
    restricted  = "length(not_null(properties.sharedUserList, `[]`))"
    resource_id = "properties.metadata.ResourceId"
    creator     = "properties.metadata.\"azd-created-by\""
    environment = "properties.metadata.\"azd-environment\""
    project     = "properties.metadata.\"azd-project-id\""
  }
}

locals {
  monitoring_project_rows        = local.monitoring_enabled ? try(data.azapi_resource_list.monitoring_project_connections[0].output.connections, null) : []
  monitoring_account_rows        = local.monitoring_enabled ? try(data.azapi_resource_list.monitoring_account_connections[0].output.connections, null) : []
  monitoring_project_connections = local.monitoring_project_rows != null ? local.monitoring_project_rows : []
  monitoring_account_connections = local.monitoring_account_rows != null ? local.monitoring_account_rows : []
  monitoring_project_by_name = {
    for connection in local.monitoring_project_connections : lower(connection.name) => connection
  }
  monitoring_effective_connections = concat(
    [for connection in local.monitoring_project_connections : merge(connection, { inherited = false })],
    [for connection in local.monitoring_account_connections : merge(connection, { inherited = true }) if connection.shared == true],
  )
  monitoring_appinsights = [
    for connection in local.monitoring_effective_connections : connection
    if try(lower(connection.category), "") == "appinsights"
  ]
  monitoring_existing_names = sort([for connection in local.monitoring_appinsights : connection.name])
  monitoring_network_policies = local.monitoring_managed ? [
    data.azapi_resource.monitoring_account[0].output,
    data.azapi_resource.monitoring_project[0].output,
  ] : []
  monitoring_key_policy_sources = {
    component = local.monitoring_managed ? (
      data.azapi_resource.monitoring_component[0].exists ? data.azapi_resource.monitoring_component[0].output : null
    ) : null
    workspace = var.monitoring_mode == "reuse-connect" ? data.azapi_resource.monitoring_workspace[0].output : null
    owned_workspace = var.monitoring_mode == "create" ? (
      data.azapi_resource.monitoring_owned_workspace[0].exists ? data.azapi_resource.monitoring_owned_workspace[0].output : null
    ) : null
  }
  monitoring_key_policies = [
    for policy in local.monitoring_key_policy_sources : {
      for field in keys(local.monitoring_policy_fields) : field => policy[field]
    } if policy != null
  ]
  monitoring_owned_connections = concat(
    local.monitoring_appinsights,
    local.monitoring_managed ? (
      data.azapi_resource.monitoring_connection_slot[0].exists ?
      [merge(data.azapi_resource.monitoring_connection_slot[0].output, { inherited = false })] : []
    ) : [],
  )
}

resource "terraform_data" "monitoring_safety" {
  count = local.monitoring_enabled ? 1 : 0

  lifecycle {
    precondition {
      condition = (
        try(data.azapi_resource.monitoring_project[0].output.present, false) == true &&
        try(lower(data.azapi_resource.monitoring_project[0].output.resource_id), "") == lower(local.monitoring_project_id) &&
        try(data.azapi_resource.monitoring_account[0].output.present, false) == true &&
        try(lower(data.azapi_resource.monitoring_account[0].output.resource_id), "") == lower(local.monitoring_account_id)
      )
      error_message = "Monitoring discovery must verify the selected Foundry project and account identities."
    }
    precondition {
      condition = (
        local.monitoring_project_rows != null && local.monitoring_account_rows != null &&
        alltrue([for connection in concat(local.monitoring_project_connections, local.monitoring_account_connections) :
          try(length(connection.name) > 0, false) && try(length(connection.category) > 0, false)
        ])
      )
      error_message = "Monitoring connection discovery is incomplete; absence cannot be inferred from a failed or malformed read."
    }
    precondition {
      condition = alltrue([for connection in local.monitoring_account_connections :
        connection.shared == true ? true : (
          contains(keys(local.monitoring_project_by_name), lower(connection.name)) ? (
            try(lower(connection.target), "") == try(lower(local.monitoring_project_by_name[lower(connection.name)].target), "") &&
            lower(connection.category) == lower(local.monitoring_project_by_name[lower(connection.name)].category)
            ) : (
            lower(connection.name) != lower(local.monitoring_name) &&
            (lower(connection.category) != "appinsights" || (connection.shared == false && connection.restricted == 0))
          )
        )
      ])
      error_message = "An account connection protects the monitoring name, has ambiguous identity, or uses unsupported restricted sharing."
    }
    precondition {
      condition = alltrue([for connection in local.monitoring_effective_connections :
        lower(connection.name) != lower(local.monitoring_name) || lower(connection.category) == "appinsights"
        ]) && alltrue([for connection in local.monitoring_appinsights :
        try(lower(connection.target), "") == lower(local.monitoring_component_id) &&
        contains(["apikey", "aad", "managedidentity"], try(lower(connection.auth), "")) &&
        (connection.resource_id == null ? true : try(lower(connection.resource_id), "") == try(lower(connection.target), ""))
      ])
      error_message = "Effective AppInsights connections conflict with the selected component, authentication, or resource identity."
    }
    precondition {
      condition = local.monitoring_managed ? alltrue([for connection in local.monitoring_owned_connections :
        connection.inherited == false && connection.shared != true && connection.restricted == 0 &&
        try(lower(connection.name), "") == lower(local.monitoring_name) &&
        try(lower(connection.category), "") == "appinsights" && try(lower(connection.auth), "") == "apikey" &&
        try(lower(connection.target), "") == lower(local.monitoring_component_id) &&
        try(lower(connection.resource_id), "") == lower(local.monitoring_component_id) &&
        connection.creator == "azure.ai.projects" && connection.environment == var.environment_name &&
        try(lower(connection.project), "") == lower(local.monitoring_project_id)
      ]) : length(local.monitoring_appinsights) > 0
      error_message = "Preserve external monitoring with monitoring_mode already-connected. Managed connections require the original project/environment ownership binding."
    }
    precondition {
      condition = var.monitoring_mode == "create" ? (
        (data.azapi_resource.monitoring_component[0].exists ? (
          try(data.azapi_resource.monitoring_component[0].tags["azd-created-by"], "") == "azure.ai.projects" &&
          try(data.azapi_resource.monitoring_component[0].tags["azd-environment"], "") == var.environment_name &&
          try(lower(data.azapi_resource.monitoring_component[0].tags["azd-monitoring-project"]), "") == lower(local.monitoring_project_id) &&
          try(lower(data.azapi_resource.monitoring_component[0].output.workspace_id), "") == lower(local.monitoring_workspace_id)
        ) : true) &&
        (data.azapi_resource.monitoring_owned_workspace[0].exists ? (
          try(data.azapi_resource.monitoring_owned_workspace[0].tags["azd-created-by"], "") == "azure.ai.projects" &&
          try(data.azapi_resource.monitoring_owned_workspace[0].tags["azd-environment"], "") == var.environment_name &&
          try(lower(data.azapi_resource.monitoring_owned_workspace[0].tags["azd-monitoring-project"]), "") == lower(local.monitoring_project_id) &&
          try(lower(data.azapi_resource.monitoring_owned_workspace[0].output.resource_id), "") == lower(local.monitoring_workspace_id)
        ) : true)
      ) : true
      error_message = "The monitoring creation graph cannot adopt, retag, or retarget an existing component/workspace; use its resource ID for reuse."
    }
    precondition {
      condition = alltrue([for policy in concat(local.monitoring_network_policies, local.monitoring_key_policies) :
        try(policy.present, false) == true &&
        lower(coalesce(policy.ingestion, "Enabled")) == "enabled" &&
        lower(coalesce(policy.public_access, "Enabled")) == "enabled" &&
        lower(coalesce(policy.default_action, "Allow")) == "allow"
        ]) && alltrue([for policy in local.monitoring_key_policies :
        (policy.local_auth == null || policy.local_auth == false) &&
        (policy.workspace_local_auth == null || policy.workspace_local_auth == false)
      ])
      error_message = "ApiKey monitoring cannot enable local authentication or bypass restricted ingestion/network policy."
    }
  }
}

# Managed counts depend only on authored mode, never on live connection existence.
resource "azapi_resource" "monitoring_workspace" {
  count     = var.monitoring_mode == "create" ? 1 : 0
  type      = "Microsoft.OperationalInsights/workspaces@2023-09-01"
  name      = "log-${local.monitoring_token}"
  parent_id = local.monitoring_group_id
  location  = var.location
  tags      = local.monitoring_tags
  body = {
    properties = {
      retentionInDays = 30
      sku             = { name = "PerGB2018" }
    }
  }
  response_export_values = ["id"]
  depends_on             = [terraform_data.monitoring_safety]
}

resource "azapi_resource" "monitoring_component" {
  count     = var.monitoring_mode == "create" ? 1 : 0
  type      = "Microsoft.Insights/components@2020-02-02"
  name      = "appi-${local.monitoring_token}"
  parent_id = local.monitoring_group_id
  location  = var.location
  tags      = local.monitoring_tags
  body = {
    kind = "web"
    properties = {
      Application_Type    = "web"
      WorkspaceResourceId = azapi_resource.monitoring_workspace[0].id
    }
  }
  response_export_values = ["properties.AppId", "properties.WorkspaceResourceId"]
  depends_on             = [terraform_data.monitoring_safety]
}

# The component credential is neither a data-source output nor a state attribute.
ephemeral "azapi_resource_action" "monitoring_credential" {
  count                  = local.monitoring_managed ? 1 : 0
  type                   = "Microsoft.Insights/components@2020-02-02"
  resource_id            = var.monitoring_mode == "create" ? azapi_resource.monitoring_component[0].id : local.monitoring_component_id
  method                 = "GET"
  response_export_values = ["properties.ConnectionString"]
  depends_on             = [terraform_data.monitoring_safety]
}

resource "azapi_resource" "monitoring_connection" {
  count     = local.monitoring_managed ? 1 : 0
  type      = "Microsoft.CognitiveServices/accounts/projects/connections@2025-04-01-preview"
  name      = local.monitoring_name
  parent_id = local.monitoring_project_id
  body = {
    properties = {
      category      = "AppInsights"
      target        = var.monitoring_mode == "create" ? azapi_resource.monitoring_component[0].id : local.monitoring_component_id
      authType      = "ApiKey"
      isSharedToAll = false
      metadata = {
        ApiType           = "Azure"
        ResourceId        = var.monitoring_mode == "create" ? azapi_resource.monitoring_component[0].id : local.monitoring_component_id
        "azd-created-by"  = "azure.ai.projects"
        "azd-environment" = var.environment_name
        "azd-project-id"  = local.monitoring_project_id
      }
    }
  }
  sensitive_body = {
    properties = {
      credentials = {
        key = ephemeral.azapi_resource_action.monitoring_credential[0].output.properties.ConnectionString
      }
    }
  }
  sensitive_body_version = { "properties.credentials.key" = "1" }
  response_export_values = ["name", "properties.category", "properties.target", "properties.authType"]
}

output "AZURE_APPLICATION_INSIGHTS_RESOURCE_ID" {
  value = local.monitoring_enabled ? (
    var.monitoring_mode == "create" ? azapi_resource.monitoring_component[0].id : data.azapi_resource.monitoring_component[0].output.resource_id
  ) : ""
}

output "AZURE_APPLICATION_INSIGHTS_APP_ID" {
  value = local.monitoring_enabled ? (
    var.monitoring_mode == "create" ? azapi_resource.monitoring_component[0].output.properties.AppId : data.azapi_resource.monitoring_component[0].output.app_id
  ) : ""
}

output "AZURE_LOG_ANALYTICS_WORKSPACE_RESOURCE_ID" {
  value = local.monitoring_enabled ? (
    var.monitoring_mode == "create" ? azapi_resource.monitoring_component[0].output.properties.WorkspaceResourceId : data.azapi_resource.monitoring_workspace[0].output.resource_id
  ) : ""
}

output "AZURE_AI_PROJECT_APPINSIGHTS_CONNECTION_NAME" {
  value = local.monitoring_enabled ? (
    local.monitoring_managed ? azapi_resource.monitoring_connection[0].name : try(local.monitoring_existing_names[0], "")
  ) : ""
}

output "AZD_FOUNDRY_MONITORING_MODE" {
  value = var.monitoring_mode
}
