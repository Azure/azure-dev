{{define "main.parameters.json" -}}
{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      },
      {{/* Preserve the resources provider's saved quota-aware location after export switches this entry to Bicep. */}}
      {{/* entryEnvKey scopes it as AZURE_RESOURCES_<ENTRY>__AI_DEPLOYMENTS_LOCATION. */}}
      {{- if .AiFoundryProject}}
      "aiDeploymentsLocation": {
        "value": "{{printf "${%s}" (entryEnvKey .LayerName "AZURE_AI_DEPLOYMENTS_LOCATION")}}"
      },
      {{- end}}
      {{- range .Parameters}}
      "{{.Name}}": {
        "value": {{formatParam "        " "  " .Value}}
      },
      {{- end}}
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "principalType": {
        "value": "${AZURE_PRINCIPAL_TYPE}"
      }
    }
}
{{ end}}
