{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "databaseAuthentication": {
      "value": {
        "type": "${SPRING_DATABASE_AUTHENTICATION:-managedidentity}",
        "administratorName": "${SPRING_DATABASE_ADMINISTRATOR_NAME:-}",
        "administratorPrincipalId": "${SPRING_DATABASE_ADMINISTRATOR_OBJECT_ID:-}",
        "administratorPassword": "${SPRING_DATABASE_PASSWORD:-}",
        "applicationPassword": "${SPRING_DATABASE_APP_PASSWORD:-}"
      }
    },
    "databaseName": {
      "value": "${SPRING_DATABASE_NAME:-petclinic}"
    },
    "databaseUsername": {
      "value": "${SPRING_DATABASE_USERNAME:-petclinic_app}"
    },
    "imageName": {
      "value": "${SERVICE_PETCLINIC_IMAGE_NAME:-mcr.microsoft.com/k8se/quickstart:latest}"
    }
  }
}
