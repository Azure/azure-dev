      "id": "azure.ai.rle",
      "namespace": "ai.rle",
      "displayName": "RLE (Preview)",
      "description": "Manage RLE resources from your terminal. Commands are hidden by default; set AZD_AI_RLE_ENABLE=true to enable them. (Preview)",
      "versions": [
        {
          "version": "0.4.0-preview.nightly.6741816",
          "capabilities": [
            "custom-commands",
            "metadata"
          ],
          "usage": "azd ai rle <command> [options]",
          "examples": [
            {
              "name": "init",
              "description": "Copy the OpenEnv echo sample into a local RLE environment.",
              "usage": "azd ai rle init"
            },
            {
              "name": "publish",
              "description": "Build, push, and create or update the RLE environment.",
              "usage": "azd ai rle publish --version-bump major"
            },
            {
              "name": "run",
              "description": "Build and run the local RLE environment container.",
              "usage": "azd ai rle run"
            },
            {
              "name": "invoke",
              "description": "Create a temporary RLE instance and open an OpenEnv runtime shell.",
              "usage": "azd ai rle invoke [environment-name] [--version <version>]"
            },
            {
              "name": "list",
              "description": "List RLE environments in a Foundry project.",
              "usage": "azd ai rle list"
            },
            {
              "name": "show",
              "description": "Show the details and version history for an RLE environment.",
              "usage": "azd ai rle show [environment-name]"
            }
